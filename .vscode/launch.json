{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Servidor (uvicorn con recarga)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "jinja": false,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Servidor (run.py, sin recarga)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
